(defpackage #:org-templater-test
  (:use #:cl)
  (:export #:run))
(in-package #:org-templater-test)

(defun config (&rest plist)
  "Return a hash table that maps each key in PLIST to its value."
  (let ((table (make-hash-table :test #'eq)))
    (loop for (key value) on plist by (lambda (tail) (nthcdr 2 tail))
          do (setf (gethash key table) value))
    table))

(defun render (template &rest plist)
  "Render TEMPLATE with a config made from the keys and values in PLIST."
  (org-templater:render :template template :config (apply #'config plist)))

(defun run ()
  "Run the render tests.
Signal an error when one fails, and return t when all pass."
  (assert (string= (render "Hello {{{:name}}}." :name "AL")
                   "Hello AL."))
  (assert (string= (render "X{{{:absent}}}Y")
                   "XY"))
  (assert (string= (render (format nil "#+begin_when :hurry-up-p~%HURRY~%#+end_when~%AFTER~%")
                                   :hurry-up-p t)
                   (format nil "HURRY~%AFTER~%")))
  (assert (string= (render (format nil "#+begin_when :ste-p~%STE~%#+end_when~%AFTER~%"))
                   (format nil "AFTER~%")))
  (assert (string= (render (format nil "* Hurry~%:PROPERTIES:~%:WHEN: :hurry-up-p~%:END:~%body~%* Next~%kept~%")
                                   :hurry-up-p t)
                   (format nil "* Hurry~%body~%* Next~%kept~%")))
  (assert (string= (render (format nil "* Hidden~%:PROPERTIES:~%:WHEN: :immutable-p~%:END:~%secret~%** Child~%also~%* Next~%kept~%")
                                   :immutable-p nil)
                   (format nil "* Next~%kept~%")))
  (assert (string= (render (format nil "* Shown~%:PROPERTIES:~%:WHEN: :show~%:CUSTOM: yes~%:END:~%body~%")
                                   :show t)
                   (format nil "* Shown~%:PROPERTIES:~%:CUSTOM: yes~%:END:~%body~%")))
  (handler-case
      (progn
        (render "{{{:bad key}}}")
        (error "Expected invalid placeholder to signal."))
    (org-templater:placeholder-invalid-error (condition)
      (assert (string= (org-templater:placeholder-invalid-error-text condition)
                       ":bad key"))))
  (loop for (arguments condition-type)
          in `(((:template ,(format nil "#+end_when~%"))
                org-templater:when-block-end-error)
               ((:template ,(format nil "#+begin_when :a~%"))
                org-templater:when-block-unclosed-error)
               ((:template ,(format nil "#+begin_when a~%#+end_when~%"))
                org-templater:when-condition-error)
               ((:template ,(format nil "* H~%:PROPERTIES:~%"))
                org-templater:property-drawer-unclosed-error)
               ((:template "{{{:a")
                org-templater:placeholder-unclosed-error)
               (()
                org-templater:render-source-error)
               ((:template "a" :template-path "b")
                org-templater:render-source-error)
               ((:template "a" :config 3)
                org-templater:render-argument-type-error)
               ((:template 4)
                org-templater:render-argument-type-error))
        do (assert (eq (handler-case
                           (progn
                             (apply #'org-templater:render arguments)
                             nil)
                         (error (condition)
                           (type-of condition)))
                       condition-type)))
  t)
